Options -Indexes

<IfModule mod_rewrite.c>
    RewriteEngine On
    # Bloquear ejecución de PHP en uploads
    RewriteCond %{REQUEST_FILENAME} -f
    RewriteRule ^uploads/.*\.php$ - [F,L]
    RewriteRule ^uploads/.*\.(phtml|php3|php4|php5|php7|php8|phar)$ - [F,L]
</IfModule>

<FilesMatch "\.(env|json|lock|md|log)$">
    Require all denied
</FilesMatch>