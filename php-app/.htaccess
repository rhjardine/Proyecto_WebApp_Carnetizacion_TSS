Options -Indexes

<IfModule mod_rewrite.c>
    RewriteEngine On
    # Bloquear ejecución de PHP en uploads
    RewriteCond %{REQUEST_FILENAME} -f
    RewriteRule ^uploads/.*\.php$ - [F,L]
    RewriteRule ^uploads/.*\.(phtml|php3|php4|php5|php7|php8|phar)$ - [F,L]
</IfModule>

# Se añaden sql, ini, bak, zip, rar, sh y txt: el bloqueo de .sql vivía sólo en
# apache-vhost-xampp.conf, de modo que en una instalación normal bajo htdocs
# (sin VirtualHost) los volcados de db/ quedaban descargables por HTTP.
<FilesMatch "\.(env|json|lock|md|log|sql|ini|bak|zip|rar|sh)$">
    Require all denied
</FilesMatch>

# Los directorios de esquema y de archivos cargados no deben servirse nunca,
# independientemente de la extensión de su contenido.
RedirectMatch 403 ^/.*/(db|storage)/.*$